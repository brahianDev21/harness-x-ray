{
  "directories": [
    { "id": "dist", "folder": "dist", "why": "Build output of many bundlers and compilers" },
    { "id": "build", "folder": "build", "why": "Build output of several toolchains (Gradle, Create React App, setuptools)" },
    { "id": "out", "folder": "out", "why": "Build or export output (for example a Next.js static export)" },
    { "id": "coverage", "folder": "coverage", "why": "Test coverage reports written by test runners" },
    { "id": "next-build", "folder": ".next", "why": "Next.js build cache and output" },
    { "id": "nuxt-build", "folder": ".nuxt", "why": "Nuxt build output" },
    { "id": "svelte-kit-build", "folder": ".svelte-kit", "why": "SvelteKit generated files" },
    { "id": "turbo-cache", "folder": ".turbo", "why": "Turborepo task cache" },
    { "id": "storybook-build", "folder": "storybook-static", "why": "Static Storybook build output" },
    { "id": "node-modules", "folder": "node_modules", "why": "Installed dependencies, never source" },
    { "id": "vendor", "folder": "vendor", "why": "Vendored dependencies (Go, PHP, Ruby)" },
    { "id": "playwright-report", "folder": "playwright-report", "why": "Playwright HTML report" },
    { "id": "test-results", "folder": "test-results", "why": "Test artifacts written by Playwright and similar runners" },
    { "id": "python-bytecode", "folder": "__pycache__", "why": "Python bytecode cache" },
    { "id": "python-venv", "folder": ".venv", "why": "Python virtual environment with installed packages" }
  ],
  "files": [
    { "id": "minified-js", "glob": "*.min.js", "regex": "\\.min\\.js$", "why": "Minified JavaScript bundle" },
    { "id": "minified-css", "glob": "*.min.css", "regex": "\\.min\\.css$", "why": "Minified stylesheet" },
    { "id": "source-map", "glob": "*.map", "regex": "\\.map$", "why": "Source map, produced from another file" },
    { "id": "typescript-buildinfo", "glob": "*.tsbuildinfo", "regex": "\\.tsbuildinfo$", "why": "TypeScript incremental build cache" },
    { "id": "protobuf-go", "glob": "*.pb.go", "regex": "\\.pb\\.go$", "why": "Go code generated by protoc" },
    { "id": "protobuf-python", "glob": "*_pb2.py", "regex": "_pb2\\.py$", "why": "Python code generated by protoc" }
  ],
  "lockfiles": [
    "package-lock.json",
    "npm-shrinkwrap.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "Cargo.lock",
    "poetry.lock",
    "uv.lock",
    "Pipfile.lock",
    "Gemfile.lock",
    "composer.lock",
    "go.sum",
    "Podfile.lock",
    "pubspec.lock",
    "mix.lock",
    "flake.lock",
    "packages.lock.json",
    "deno.lock",
    "gradle.lockfile",
    "Package.resolved"
  ],
  "doNotTouchPhrases": [
    "do not edit",
    "don't edit",
    "do not modify",
    "don't modify",
    "do not touch",
    "don't touch",
    "never edit",
    "never modify",
    "generated",
    "read-only"
  ]
}
