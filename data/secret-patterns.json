{
  "fileNames": [
    { "id": "dotenv", "pattern": "^\\.env(\\..+)?$", "except": "\\.(example|sample|template)$" },
    { "id": "pem", "pattern": "\\.pem$" },
    { "id": "key", "pattern": "\\.key$" },
    { "id": "pkcs12", "pattern": "\\.p12$" },
    { "id": "pfx", "pattern": "\\.pfx$" },
    { "id": "ssh-rsa", "pattern": "^id_rsa$" },
    { "id": "ssh-ed25519", "pattern": "^id_ed25519$" },
    { "id": "credentials-json", "pattern": "^credentials\\.json$" }
  ],
  "contentPatterns": [
    { "id": "anthropic-api-key", "pattern": "(?<![A-Za-z0-9])sk-ant-[A-Za-z0-9_-]{20,}", "prefix": "sk-ant-" },
    { "id": "generic-sk-key", "pattern": "(?<![A-Za-z0-9])sk-(?!ant-)[A-Za-z0-9_-]{20,}", "prefix": "sk-" },
    { "id": "github-classic-token", "pattern": "(?<![A-Za-z0-9])ghp_[A-Za-z0-9]{20,}", "prefix": "ghp_" },
    { "id": "github-oauth-token", "pattern": "(?<![A-Za-z0-9])gho_[A-Za-z0-9]{20,}", "prefix": "gho_" },
    { "id": "github-fine-grained-token", "pattern": "(?<![A-Za-z0-9])github_pat_[A-Za-z0-9_]{20,}", "prefix": "github_pat_" },
    { "id": "aws-access-key-id", "pattern": "(?<![A-Za-z0-9])AKIA[0-9A-Z]{16}(?![A-Za-z0-9])", "prefix": "AKIA" },
    { "id": "slack-token", "pattern": "(?<![A-Za-z0-9])xox[abprs]-[A-Za-z0-9-]{10,}", "prefix": "xox" },
    { "id": "private-key-header", "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----", "prefix": "-----BEGIN" }
  ],
  "genericAssignment": {
    "id": "generic-assignment",
    "keyPattern": "api[_-]?key|secret|token|password|passwd|authorization",
    "minValueLength": 16,
    "placeholders": ["^\\$\\{", "^<.*>$", "^your[-_]", "xxxx", "^changeme$"]
  }
}
