    {
      "id": "download-execute",
      "match": "download-pipe",
      "patterns": [
        {
          "id": "download-piped-to-shell",
          "downloaders": ["curl", "wget", "iwr", "irm", "invoke-webrequest", "invoke-restmethod"],
          "prefixes": ["sudo", "doas", "env"],
          "shells": [
            "sh", "bash", "zsh", "dash", "ksh", "fish", "pwsh", "powershell", "iex", "invoke-expression",
            "python", "python3", "node", "perl", "ruby"
          ]
        }
      ]
    },
    {
      "id": "disable-controls",
      "match": "phrase",
      "patterns": [
        { "id": "skip-permissions-flag", "text": "dangerously-skip-permissions" },
        { "id": "bypass-permissions-mode", "text": "bypasspermissions" },
        { "id": "disable-all-hooks-setting", "text": "disableallhooks" },
        { "id": "disable-sandbox-setting", "text": "dangerouslydisablesandbox" },
        { "id": "disable-the-hook", "text": "disable the hook" },
        { "id": "disable-the-hooks", "text": "disable the hooks" },
