    {
      "id": "html-comment",
      "match": "html-comment",
      "patterns": [{ "id": "html-comment-open", "text": "<!--" }]
    },
    {
      "id": "invisible-unicode",
      "match": "code-point-range",
      "patterns": [
        { "id": "zero-width-and-direction-marks", "from": "U+200B", "to": "U+200F" },
        { "id": "bidi-embedding-and-override", "from": "U+202A", "to": "U+202E" },
        { "id": "invisible-operators", "from": "U+2060", "to": "U+2064" },
        { "id": "bidi-isolates", "from": "U+2066", "to": "U+2069" },
        { "id": "byte-order-mark-inside", "from": "U+FEFF", "to": "U+FEFF" },
        { "id": "tag-characters", "from": "U+E0000", "to": "U+E007F" }
      ]
    }
