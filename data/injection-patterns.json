        { "id": "disable-hooks", "text": "disable hooks" },
        { "id": "turn-off-the-hooks", "text": "turn off the hooks" },
        { "id": "remove-the-hooks", "text": "remove the hooks" },
        { "id": "delete-the-hooks", "text": "delete the hooks" },
        { "id": "disable-the-sandbox", "text": "disable the sandbox" },
        { "id": "skip-the-permission-prompts", "text": "skip the permission prompts" },
