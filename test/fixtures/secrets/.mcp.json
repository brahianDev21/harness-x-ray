{
  "mcpServers": {
    "docs": {
      "type": "http",
      "url": "https://docs.example.invalid/mcp",
      "headers": {
        "Authorization": "Bearer ${DOCS_TOKEN}"
      }
    },
    "local-tools": {
      "command": "node",
      "args": ["./tools/server.mjs", "--api-key", "${LOCAL_API_KEY}"],
      "env": {
        "LOCAL_PASSWORD": "${LOCAL_PASSWORD}"
      }
    }
  }
}
